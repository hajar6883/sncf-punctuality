// SNCF TGV punctuality - Qlik Sense load script.
// Create one section per ///$tab block in the data load editor, in this order,
// after Qlik's default Main section (keep its number/date SET statements).

///$tab Settings
SET HidePrefix = '%';
SET MonthNames = 'janv.;févr.;mars;avr.;mai;juin;juil.;août;sept.;oct.;nov.;déc.';
SET LongMonthNames = 'janvier;février;mars;avril;mai;juin;juillet;août;septembre;octobre;novembre;décembre';

SET vSource = 'lib://DataFiles/';       // Parquet files exported by dbt
SET vQvd    = 'lib://DataFiles/qvd/';   // if STORE fails on the subfolder, use 'lib://DataFiles/'

SET vMinTrains = 50;                    // min trains ran to rank a route (docs: qlik/model_notes.md)
SET vClearCalendar = Année=, Mois=, [Année-Mois]=, Trimestre=, Saison=, [Dernier mois]=, [Mois perturbé]=, Perturbation=;

// Month key from a Parquet date, whether it arrives as a date or as 'YYYY-MM-DD' text
SET fMonthKey = Num(Floor(Alt($1, Date#($1, 'YYYY-MM-DD'))));


///$tab Extract
// Layer 1: Parquet -> QVD. In production this would be a separate extract app.
FOR EACH vTable IN 'fact_punctuality', 'fact_delay_cause', 'dim_route', 'dim_date', 'dim_delay_cause'
    [$(vTable)]:
    LOAD * FROM [$(vSource)$(vTable).parquet] (parquet);

    STORE [$(vTable)] INTO [$(vQvd)$(vTable).qvd] (qvd);
    DROP TABLE [$(vTable)];
NEXT vTable


///$tab Model
// Layer 2: QVD -> data model. Only key fields are shared between tables.
Regularite:
LOAD
    punctuality_key                     AS %PunctualityKey,
    Date($(fMonthKey(month_start)))     AS %DateKey,
    route_key                           AS %RouteKey,
    trains_planned,
    trains_cancelled,
    trains_ran,
    trains_on_time,
    trains_late_arrival,
    trains_late_15,
    trains_late_30,
    trains_late_60,
    trains_late_departure,
    delay_minutes_all_arrival,
    delay_minutes_late_arrival,
    journey_minutes,
    has_cause_data,
    arrival_comment                     AS [Commentaire retards]
FROM [$(vQvd)fact_punctuality.qvd] (qvd);

Liaisons:
LOAD
    route_key                           AS %RouteKey,
    service                             AS Service,
    route_label                         AS Liaison,
    route_pair                          AS [Liaison (2 sens)],
    origin_station                      AS [Gare de départ],
    destination_station                 AS [Gare d'arrivée],
    origin_country                      AS [Pays de départ],
    destination_country                 AS [Pays d'arrivée],
    If(touches_paris = 1, 'Oui', 'Non') AS [Dessert Paris],
    months_available                    AS [Mois d'historique]
FROM [$(vQvd)dim_route.qvd] (qvd);

CausesRetard:
LOAD
    punctuality_key                     AS %PunctualityKey,
    cause_key                           AS %CauseKey,
    cause_share_pct,
    est_late_trains
FROM [$(vQvd)fact_delay_cause.qvd] (qvd);

Causes:
LOAD
    cause_key                           AS %CauseKey,
    Dual(cause_label_fr, sort_order)    AS Cause,   // text shown, number used for sorting
    cause_label_en                      AS [Cause (EN)]
FROM [$(vQvd)dim_delay_cause.qvd] (qvd);


///$tab Calendar
// Disrupted months come from dbt (single source of truth); a mapping table is a lookup, dropped at the end
MapPerturbation:
MAPPING LOAD
    $(fMonthKey(month_start)),
    disruption
FROM [$(vQvd)dim_date.qvd] (qvd)
WHERE is_disrupted = 1;

// Min/max over the field's distinct values, not over every fact row
TmpRange:
LOAD
    Min(FieldValue('%DateKey', RecNo())) AS MinDate,
    Max(FieldValue('%DateKey', RecNo())) AS MaxDate
AUTOGENERATE FieldValueCount('%DateKey');

LET vMinDate = Num(Peek('MinDate', 0, 'TmpRange'));
LET vMaxDate = Num(Peek('MaxDate', 0, 'TmpRange'));
DROP TABLE TmpRange;

// Master calendar: one row per month with no gaps, built by the preceding load below
Calendrier:
LOAD
    %DateKey,
    Year(%DateKey)                                     AS Année,
    Month(%DateKey)                                    AS Mois,
    Date(%DateKey, 'MMM YYYY')                         AS [Année-Mois],
    'T' & Ceil(Month(%DateKey) / 3)                    AS Trimestre,
    Pick(Month(%DateKey), 'Hiver', 'Hiver', 'Printemps', 'Printemps', 'Printemps',
         'Été', 'Été', 'Été', 'Automne', 'Automne', 'Automne', 'Hiver') AS Saison,
    Year(%DateKey) * 12 + Month(%DateKey)              AS %MoisIndex,   // consecutive months differ by 1
    ApplyMap('MapPerturbation', Num(%DateKey), Null()) AS Perturbation,
    If(Len(ApplyMap('MapPerturbation', Num(%DateKey), '')) > 0, 1, 0) AS [Mois perturbé],
    If(Num(%DateKey) = $(vMaxDate), 1, 0)              AS [Dernier mois];
LOAD
    Date(AddMonths($(vMinDate), IterNo() - 1))         AS %DateKey
AUTOGENERATE 1
WHILE AddMonths($(vMinDate), IterNo() - 1) <= $(vMaxDate);


///$tab Finalize
// Hash keys -> small integers. Done last: AutoNumber values change between reloads, so never store them in QVDs.
AUTONUMBER %PunctualityKey, %RouteKey, %CauseKey;
