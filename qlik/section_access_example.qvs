// EXAMPLE ONLY - not part of the app. A wrong section access can lock everyone, including you, out of the app.
// Scenario: regional managers see only their service; the admin sees everything.
// Check the current Qlik Cloud docs for the user field (USER.EMAIL / USERID / GROUP) before using it.

Section Access;
LOAD * INLINE [
    ACCESS, USER.EMAIL, SERVICE
    ADMIN, INTERNAL\SA_SCHEDULER, *
    ADMIN, admin@example.com, *
    USER, manager.national@example.com, NATIONAL
    USER, manager.international@example.com, INTERNATIONAL
];
Section Application;

// Reduction field: same name as in section access, upper-case name and values.
// In Liaisons, add: Upper(service) AS SERVICE
// '*' means "all values listed in this table", not all values in the data.
